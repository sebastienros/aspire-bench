        {
          "name": "list_resources",
          "description": "List the application resources for the selected AppHost. Includes runtime information such as resource type, state, source, endpoints, health status, relationships, and API-visible command metadata without current or default argument values. Returns up to 64 resources ordered by runtime name; use offset and limit to page through all visible resources.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "default": 0,
                "description": "Zero-based offset in the visible resources ordered by runtime name. Use next_offset from the previous response to continue."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "default": 64,
                "description": "Maximum number of resources to return in this page."
              }
            },
            "additionalProperties": false
          },
          "annotations": {
            "destructiveHint": false,
            "readOnlyHint": true
          }
        },
        {
          "name": "wait_for_resources",
          "description": "Wait for selected application resources to reach a healthy, up, or down state.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "resourceNames": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "targetState": {
                "type": "string",
                "enum": [
                  "healthy",
                  "up",
                  "down"
                ],
                "default": "healthy"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600,
                "default": 120
              }
            },
            "additionalProperties": false
          },
          "annotations": {
            "destructiveHint": false,
            "readOnlyHint": true
          }
        },
        {
          "name": "list_console_logs",
          "description": "List console logs for a resource. The console logs includes standard output from resources and resource commands. Known resource commands are 'start', 'stop' and 'restart' which are used to start and stop resources. Don't print the full console logs in the response to the user. Console logs should be examined when determining why a resource isn't running.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "resourceName": {
                "type": "string",
                "description": "The resource name."
              },
              "search": {
                "type": "string",
                "description": "Full-text search to filter log content."
              }
            },
            "required": [
              "resourceName"
            ]
          },
          "annotations": {
            "destructiveHint": false,
            "readOnlyHint": true
          }
        },
        {
          "name": "execute_resource_command",
