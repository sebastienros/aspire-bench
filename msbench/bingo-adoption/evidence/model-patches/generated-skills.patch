diff --git a/apphost.cs b/apphost.cs
new file mode 100644
index 0000000..e3ba6dd
--- /dev/null
+++ b/apphost.cs
@@ -0,0 +1,55 @@
+﻿#:package Aspire.Hosting.JavaScript
+#:package Aspire.Hosting.PostgreSQL
+#:package Aspire.Hosting.Redis
+#:sdk Aspire.AppHost.Sdk@13.6.0
+#:property AspireUseCliBundle=true
+
+var builder = DistributedApplication.CreateBuilder(args);
+
+var runId = Environment.GetEnvironmentVariable("BENCH_RUN_ID");
+if (string.IsNullOrWhiteSpace(runId))
+{
+    throw new InvalidOperationException("BENCH_RUN_ID is required to scope dependency containers.");
+}
+
+var adminPassword = Environment.GetEnvironmentVariable("Authentication__AdminPassword");
+if (string.IsNullOrWhiteSpace(adminPassword))
+{
+    throw new InvalidOperationException("Authentication__AdminPassword is required for the admin seed.");
+}
+var adminPasswordParameter = builder.AddParameter("admin-password", () => adminPassword, secret: true);
+
+var postgres = builder.AddPostgres("postgres")
+    .WithImageTag("18.3")
+    .WithContainerName($"{runId}-postgres");
+var db = postgres.AddDatabase("db", "bingo");
+#pragma warning disable ASPIRECERTIFICATES001
+var cache = builder.AddRedis("cache")
+    .WithImageTag("8.6")
+    .WithoutHttpsCertificate()
+    .WithContainerName($"{runId}-redis");
+#pragma warning restore ASPIRECERTIFICATES001
+
+var migrations = builder.AddProject("migrations", "./src/BingoBoard.MigrationService/BingoBoard.MigrationService.csproj", launchProfileName: null)
+    .WithReference(db)
+    .WithEnvironment("Authentication__AdminPassword", adminPasswordParameter)
+    .WaitFor(db);
+
+var admin = builder.AddProject("boardadmin", "./src/BingoBoard.Admin/BingoBoard.Admin.csproj", launchProfileName: null)
+    .WithHttpEndpoint()
+    .WithEnvironment("ASPNETCORE_ENVIRONMENT", "Development")
+    .WithReference(db)
+    .WithReference(cache)
+    .WaitFor(db)
+    .WaitFor(cache)
+    .WaitForCompletion(migrations)
+    .WithHttpHealthCheck("/login")
+    .WithExternalHttpEndpoints();
+
+builder.AddViteApp("bingoboard", "./src/bingo-board")
+    .WithNpm(installCommand: "ci")
+    .WithEnvironment("BINGO_ADMIN_URL", admin.GetEndpoint("http"))
+    .WaitFor(admin)
+    .WithExternalHttpEndpoints();
+
+builder.Build().Run();
\ No newline at end of file
