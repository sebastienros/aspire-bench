diff --git a/apphost.cs b/apphost.cs
new file mode 100644
index 0000000..e34947e
--- /dev/null
+++ b/apphost.cs
@@ -0,0 +1,51 @@
+#:sdk Aspire.AppHost.Sdk@13.6.0
+#:property AspireUseCliBundle=true
+#:package Aspire.Hosting.JavaScript
+#:package Aspire.Hosting.PostgreSQL
+#:package Aspire.Hosting.Redis
+
+var builder = DistributedApplication.CreateBuilder(args);
+
+var runId = Environment.GetEnvironmentVariable("BENCH_RUN_ID")
+    ?? throw new InvalidOperationException("BENCH_RUN_ID is required.");
+var composeProject = Environment.GetEnvironmentVariable("COMPOSE_PROJECT_NAME")
+    ?? throw new InvalidOperationException("COMPOSE_PROJECT_NAME is required.");
+var adminPassword = builder.Configuration["Authentication:AdminPassword"];
+if (string.IsNullOrEmpty(adminPassword))
+    throw new InvalidOperationException("Authentication__AdminPassword is required.");
+builder.Configuration["Parameters:admin-password"] = adminPassword;
+var password = builder.AddParameter("admin-password", secret: true);
+
+var postgres = builder.AddPostgres("postgres")
+    .WithImageTag("18.3")
+    .WithContainerName($"{runId}-postgres")
+    .WithVolume($"{composeProject}_bingo-postgres-data", "/var/lib/postgresql");
+var db = postgres.AddDatabase("db", "bingo");
+var cache = builder.AddRedis("cache")
+    .WithImageTag("8.6")
+    .WithContainerName($"{runId}-redis");
+
+var migration = builder.AddProject("migration", "./src/BingoBoard.MigrationService/BingoBoard.MigrationService.csproj")
+    .WithReference(db)
+    .WithEnvironment("Authentication__AdminPassword", password)
+    .WaitFor(db);
+
+var admin = builder.AddProject("boardadmin", "./src/BingoBoard.Admin/BingoBoard.Admin.csproj", launchProfileName: null)
+    .WithHttpEndpoint()
+    .WithExternalHttpEndpoints()
+    .WithReference(db)
+    .WithReference(cache)
+    .WithEnvironment("ASPNETCORE_ENVIRONMENT", "Development")
+    .WithEnvironment("ASPIRE_VERSION", "13.6.0")
+    .WaitFor(db)
+    .WaitFor(cache)
+    .WaitForCompletion(migration);
+
+builder.AddViteApp("bingoboard", "./src/bingo-board")
+    .WithNpm(installCommand: "ci")
+    .WithReference(admin)
+    .WithEnvironment("BINGO_ADMIN_URL", admin.GetEndpoint("http"))
+    .WaitFor(admin)
+    .WithExternalHttpEndpoints();
+
+builder.Build().Run();
