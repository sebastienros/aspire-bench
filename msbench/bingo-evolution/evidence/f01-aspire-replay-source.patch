@@ -12,6 +12,32 @@ namespace BingoBoard.Admin.Services;
 /// </summary>
 public class BingoService(IDistributedCache cache, ILogger<BingoService> logger, IClientConnectionService clientService, ApplicationDbContext dbContext) : IBingoService
 {
+    public async Task<List<BingoSquare>> GetCatalogAsync(string? type, CancellationToken cancellationToken = default)
+    {
+        var query = dbContext.BingoSquares.AsNoTracking().Where(square => square.IsActive);
+        if (type is not null)
+        {
+            query = query.Where(square => square.Type == type);
+        }
+
+        var squares = await query
+            .Select(square => new BingoSquare
+            {
+                Id = square.Id,
+                Label = square.Label,
+                Type = square.Type
+            })
+            .ToListAsync(cancellationToken);
+
+        foreach (var square in squares)
+        {
+            var state = await cache.GetStringAsync($"global_square_{square.Id}", cancellationToken);
+            square.IsChecked = bool.TryParse(state, out var isChecked) && isChecked;
+        }
+
+        return squares.OrderBy(square => square.Id, StringComparer.Ordinal).ToList();
+    }
