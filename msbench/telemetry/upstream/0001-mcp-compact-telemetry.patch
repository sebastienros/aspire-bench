+    /// <summary>
+    /// Default number of trace summaries returned when the caller does not specify a limit.
+    /// </summary>
+    public const int DefaultTraceSummaryLimit = 20;
+
+    /// <summary>
+    /// Maximum number of trace summaries a caller can request.
+    /// </summary>
+    public const int MaximumTraceSummaryLimit = 200;
+
+    /// <summary>
+    /// Default number of structured log entries returned to an MCP caller that does not specify a limit.
+    /// </summary>
+    public const int DefaultStructuredLogsToolLimit = 30;
+
+    private const int SummaryDetailMaxLength = 160;
+
+    // Attributes that best identify what a span did, in order of preference.
+    private static readonly string[] s_spanDetailAttributes =
+    [
+        "db.query.text", "db.statement", "url.full", "http.url", "http.route", "rpc.method", "messaging.destination.name"
+    ];
+
+    /// <summary>
+    /// Converts OTLP resource spans to compact trace summaries for AI processing.
+    /// Each trace is a single small object: enough to choose which trace to inspect,
+    /// without the span list and attribute bags that <see cref="GetTracesJson"/> returns.
+    /// </summary>
+    /// <param name="resourceSpans">The OTLP resource spans containing trace data.</param>
+    /// <param name="getResourceName">Function to resolve resource names.</param>
+    /// <param name="limit">The maximum number of latest traces to return.</param>
+    /// <returns>A tuple containing the JSON string and a message describing what was returned.</returns>
+    public static (string json, string limitMessage) GetTraceSummariesJson(
+        IList<OtlpResourceSpansJson>? resourceSpans,
+        Func<IOtlpResource, string> getResourceName,
+        int limit = DefaultTraceSummaryLimit)
+    {
+        var traces = GetTracesFromOtlpData(resourceSpans);
+
+        var (trimmedItems, _) = GetLimitFromEndWithSummary(
+            traces,
+            Math.Clamp(limit, 1, MaximumTraceSummaryLimit),
+            "trace",
+            "traces",
+            t => GetTraceSummaryDto(t, getResourceName),
+            EstimateSerializedJsonTokenSize);
+
+        var message = traces.Count == trimmedItems.Count
+            ? $"Returned {ToQuantity(trimmedItems.Count, "trace summary", "trace summaries")}."
+            : $"Returned the latest {ToQuantity(trimmedItems.Count, "trace summary", "trace summaries")} of {traces.Count}.";
+
+        var jsonArray = new JsonArray(trimmedItems.ToArray());
+        return (jsonArray.ToJsonString(s_jsonSerializerOptions), message);
+    }
+
+    /// <summary>
+    /// Creates a compact JsonObject summarizing a trace: identity, duration, status, the resources
+    /// involved, and the child span that took the longest and the first span that failed.
+    /// </summary>
+    public static JsonObject GetTraceSummaryDto(OtlpTraceDto trace, Func<IOtlpResource, string> getResourceName)
+    {
+        var rootSpan = trace.Spans.FirstOrDefault(s => string.IsNullOrEmpty(s.Span.ParentSpanId)) ?? trace.Spans.FirstOrDefault();
+        var timestamp = rootSpan?.Span.StartTimeUnixNano is { } startNano
+            ? OtlpHelpers.UnixNanoSecondsToDateTime(startNano)
+            : (DateTime?)null;
+        var errorSpan = trace.Spans.FirstOrDefault(s => s.Span.Status?.Code == 2);
+
+        // The slowest span other than the root shows where the time went.
+        var slowestSpan = trace.Spans
+            .Where(s => !ReferenceEquals(s, rootSpan))
+            .OrderByDescending(s => CalculateDurationMs(s.Span.StartTimeUnixNano, s.Span.EndTimeUnixNano) ?? 0)
+            .FirstOrDefault();
+
+        var resources = new JsonArray(trace.Spans
+            .Select(s => getResourceName(s.Resource))
+            .Distinct(StringComparer.Ordinal)
+            .Select(name => (JsonNode)JsonValue.Create(name)!)
+            .ToArray());
+
+        var summary = new JsonObject
+        {
+            ["traceId"] = trace.TraceId,
+            ["title"] = rootSpan?.Span.Name,
+            ["durationMs"] = CalculateTraceDurationMs(trace.Spans),
+            ["hasError"] = errorSpan is not null,
+            ["timestamp"] = timestamp,
+            ["spanCount"] = trace.Spans.Count,
+            ["resources"] = resources,
+            ["slowestSpan"] = slowestSpan is null ? null : GetSpanSummary(slowestSpan, getResourceName, includeStatusMessage: false),
+            ["errorSpan"] = errorSpan is null ? null : GetSpanSummary(errorSpan, getResourceName, includeStatusMessage: true)
+        };
+
+        return StripNullProperties(summary);
+    }
+
+    private static JsonObject GetSpanSummary(OtlpSpanDto spanDto, Func<IOtlpResource, string> getResourceName, bool includeStatusMessage)
+    {
+        var span = spanDto.Span;
+        string? detail = null;
+        foreach (var key in s_spanDetailAttributes)
+        {
+            detail = GetAttributeStringValue(span.Attributes, key);
+            if (!string.IsNullOrWhiteSpace(detail))
+            {
+                break;
+            }
+        }
+
+        if (!string.IsNullOrWhiteSpace(detail))
+        {
+            // Statements span lines; a summary keeps the leading part on one line.
+            detail = string.Join(' ', detail.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
+            if (detail.Length > SummaryDetailMaxLength)
+            {
+                detail = string.Concat(detail.AsSpan(0, SummaryDetailMaxLength), "...");
+            }
+        }
+        else
+        {
+            detail = null;
+        }
+
+        var summary = new JsonObject
+        {
+            ["spanId"] = span.SpanId,
+            ["name"] = span.Name,
+            ["source"] = getResourceName(spanDto.Resource),
+            ["destination"] = GetAttributeStringValue(span.Attributes, OtlpHelpers.AspireDestinationNameAttribute),
+            ["durationMs"] = CalculateDurationMs(span.StartTimeUnixNano, span.EndTimeUnixNano),
+            ["detail"] = detail,
+            ["statusMessage"] = includeStatusMessage ? span.Status?.Message : null
+        };
+
+        return StripNullProperties(summary);
+    }
+
     /// <summary>
     /// Converts OTLP resource spans to a single trace JSON for AI processing.
     /// </summary>
