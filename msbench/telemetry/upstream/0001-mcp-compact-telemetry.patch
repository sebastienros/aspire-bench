+    private static (MockHttpClientFactory Factory, List<string> RequestedPaths) CreateTwoTraceApi()
+    {
+        static OtlpResourceSpansJson Spans(params OtlpSpanJson[] spans) => new()
+        {
+            Resource = new OtlpResourceJson
+            {
+                Attributes = [new OtlpKeyValueJson { Key = "service.name", Value = new OtlpAnyValueJson { StringValue = "api-service" } }]
+            },
+            ScopeSpans = [new OtlpScopeSpansJson { Scope = new OtlpInstrumentationScopeJson { Name = "test" }, Spans = spans }]
+        };
+
+        static OtlpSpanJson Span(string traceId, string spanId, string? parentSpanId, string name, ulong start, ulong end, string? statement = null) => new()
+        {
+            TraceId = traceId,
+            SpanId = spanId,
+            ParentSpanId = parentSpanId,
+            Name = name,
+            Kind = parentSpanId is null ? 2 : 3,
+            StartTimeUnixNano = start,
+            EndTimeUnixNano = end,
+            Status = new OtlpSpanStatusJson { Code = 1 },
+            Attributes = statement is null
+                ? []
+                : [new OtlpKeyValueJson { Key = "db.query.text", Value = new OtlpAnyValueJson { StringValue = statement } }]
+        };
+
+        var first = Spans(Span("11111111111111111111111111111111", "aaaaaaaaaaaaaaaa", null, "GET /orders", 1706540400000000000, 1706540400010000000));
+        var second = Spans(
+            Span("22222222222222222222222222222222", "bbbbbbbbbbbbbbbb", null, "POST /orders", 1706540401000000000, 1706540402000000000),
+            Span("22222222222222222222222222222222", "cccccccccccccccc", "bbbbbbbbbbbbbbbb", "postgresql", 1706540401010000000, 1706540401990000000,
+                "UPDATE orders\nSET status = @p0\nWHERE id = @p1"));
+
+        static string Serialize(params OtlpResourceSpansJson[] resourceSpans) => JsonSerializer.Serialize(
+            new TelemetryApiResponse
+            {
+                Data = new OtlpTelemetryDataJson { ResourceSpans = resourceSpans },
+                TotalCount = resourceSpans.Length,
+                ReturnedCount = resourceSpans.Length
+            },
+            OtlpJsonSerializerContext.Default.TelemetryApiResponse);
+
+        var resourcesResponse = JsonSerializer.Serialize(
+            new ResourceInfoJson[] { new() { Name = "api-service", InstanceId = null, HasLogs = true, HasTraces = true, HasMetrics = true } },
+            OtlpJsonSerializerContext.Default.ResourceInfoJsonArray);
+        var requestedPaths = new List<string>();
+        var handler = new MockHttpMessageHandler(request =>
+        {
+            var path = request.RequestUri!.AbsolutePath;
+            requestedPaths.Add(path);
+            var body = path.Contains("/resources", StringComparison.Ordinal) ? resourcesResponse
+                : path.EndsWith("/traces/11111111111111111111111111111111", StringComparison.Ordinal) ? Serialize(first)
+                : Serialize(first, second);
+            return new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent(body, System.Text.Encoding.UTF8, "application/json")
+            };
+        });
+
+        return (new MockHttpClientFactory(handler), requestedPaths);
+    }
