+    private async Task<CallToolResult> GetTraceDetailAsync(HttpClient client, string apiBaseUrl, string? dashboardBaseUrl, string traceId, ResourceInfoJson[] resources, CancellationToken cancellationToken)
+    {
+        var url = DashboardUrls.TelemetryTraceDetailApiUrl(apiBaseUrl, traceId);
+
+        logger.LogDebug(
+            "Fetching trace from {Url}",
+            McpToolHelpers.SanitizeDashboardRequestUrl(url));
+
+        var response = await client.GetAsync(url, cancellationToken).ConfigureAwait(false);
+        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
+        {
+            return new CallToolResult
+            {
+                Content = [new TextContentBlock { Text = $"Trace '{traceId}' not found." }],
+                IsError = true
+            };
+        }
+
+        TelemetryCommandHelpers.EnsureTelemetryApiResponse(response);
+
+        var apiResponse = await response.Content.ReadFromJsonAsync(OtlpJsonSerializerContext.Default.TelemetryApiResponse, cancellationToken).ConfigureAwait(false);
+        var resourceSpans = apiResponse?.Data?.ResourceSpans;
+
+        // Spans from resources excluded from MCP are never returned.
+        if (resourceSpans is not null && auxiliaryBackchannelMonitor is not null)
+        {
+            var excludedNames = await McpToolHelpers.GetExcludedResourceNamesAsync(auxiliaryBackchannelMonitor, cancellationToken).ConfigureAwait(false);
+            if (excludedNames.Count > 0)
+            {
+                resourceSpans = resourceSpans
+                    .Where(rs => rs.Resource?.GetServiceName() is not { } name || !excludedNames.Contains(name))
+                    .ToArray();
+            }
+        }
+
+        if (resourceSpans is null || SharedAIHelpers.GetTracesFromOtlpData(resourceSpans).Count == 0)
+        {
+            return new CallToolResult
+            {
+                Content = [new TextContentBlock { Text = $"Trace '{traceId}' not found." }],
+                IsError = true
+            };
+        }
+
+        var otlpResources = resources.Select(r => new SimpleOtlpResource(r.Name, r.InstanceId)).ToList();
+        var traceData = SharedAIHelpers.GetTraceJson(
+            resourceSpans,
+            getResourceName: s => OtlpHelpers.GetResourceName(s, otlpResources),
+            dashboardBaseUrl: dashboardBaseUrl);
+
+        var text = $"""
+            # TRACE DATA
+
+            {traceData}
+            """;
+
+        return new CallToolResult
+        {
+            Content = [new TextContentBlock { Text = text }]
+        };
+    }
 }
