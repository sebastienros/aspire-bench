{
  "_comment": "PLAN T4.1. One row per hosting integration. hosting = the Aspire.Hosting package; add = the AppHost expression (defaults only); client = what audit-client references; resource = the container resource scored; platform = linux/amd64 when the image has no arm64 build. Recipes are fixed before any row runs: generic = the vendor tool with credentials from the container's own env, no transport or port flag, a trivial read; alternatives are tried in order on a fail. 'host:' commands run where the agent runs (the trial image), {port:N} is the host port docker publishes for container port N. marker = write / read a value before and after a restart (not gating).",
  "rows": [
    { "row": "postgres", "hosting": "PostgreSQL", "add": "builder.AddPostgres(\"postgres\")", "client": "postgres", "resource": "postgres",
      "tool": "psql", "generic": "PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -U \"${POSTGRES_USER:-postgres}\" -tAc 'select 1'", "expect": "1",
      "alternatives": ["PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -h localhost -U postgres -tAc 'select 1'"],
      "marker": { "write": "PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -U postgres -tAc \"create table if not exists audit_marker(v text); insert into audit_marker values ('kept')\"",
                  "read": "PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -U postgres -tAc 'select v from audit_marker'" } },
    { "row": "redis", "hosting": "Redis", "add": "builder.AddRedis(\"redis\")", "client": "redis", "resource": "redis",
      "tool": "redis-cli", "generic": "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli PING", "expect": "PONG",
      "alternatives": ["REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -p 6380 PING", "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli --tls --insecure PING"],
      "marker": { "write": "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -p 6380 SET audit:marker kept", "read": "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -p 6380 GET audit:marker" } },
    { "row": "sqlserver", "hosting": "SqlServer", "add": "builder.AddSqlServer(\"sqlserver\")", "client": "sqlserver", "resource": "sqlserver", "platform": "linux/amd64",
      "tool": "/opt/mssql-tools18/bin/sqlcmd", "generic": "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -h -1 -Q 'set nocount on; select 1'", "expect": "1",
      "alternatives": ["/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -h -1 -Q 'set nocount on; select 1'"],
      "marker": { "write": "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -Q \"create table dbo.audit_marker(v nvarchar(10)); insert dbo.audit_marker values ('kept')\"",
                  "read": "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -h -1 -Q 'set nocount on; select v from dbo.audit_marker'" } },
    { "row": "mysql", "hosting": "MySql", "add": "builder.AddMySql(\"mysql\")", "client": "mysql", "resource": "mysql",
      "tool": "mysql", "generic": "mysql -uroot -p\"$MYSQL_ROOT_PASSWORD\" -N -e 'select 1'", "expect": "1",
      "alternatives": ["mysql -h 127.0.0.1 -uroot -p\"$MYSQL_ROOT_PASSWORD\" -N -e 'select 1'"],
      "marker": { "write": "mysql -uroot -p\"$MYSQL_ROOT_PASSWORD\" -e \"create database if not exists audit; create table if not exists audit.m(v text); insert into audit.m values ('kept')\"",
                  "read": "mysql -uroot -p\"$MYSQL_ROOT_PASSWORD\" -N -e 'select v from audit.m'" } },
    { "row": "mongo", "hosting": "MongoDB", "add": "builder.AddMongoDB(\"mongo\")", "client": "mongo", "resource": "mongo",
      "tool": "mongosh", "generic": "mongosh --quiet -u \"$MONGO_INITDB_ROOT_USERNAME\" -p \"$MONGO_INITDB_ROOT_PASSWORD\" --eval 'db.runCommand({ping:1}).ok'", "expect": "1",
      "alternatives": ["mongosh --quiet -u \"$MONGO_INITDB_ROOT_USERNAME\" -p \"$MONGO_INITDB_ROOT_PASSWORD\" --authenticationDatabase admin --eval 'db.runCommand({ping:1}).ok'"],
      "marker": { "write": "mongosh --quiet -u \"$MONGO_INITDB_ROOT_USERNAME\" -p \"$MONGO_INITDB_ROOT_PASSWORD\" --eval 'db.getSiblingDB(\"audit\").m.insertOne({v:\"kept\"})'",
                  "read": "mongosh --quiet -u \"$MONGO_INITDB_ROOT_USERNAME\" -p \"$MONGO_INITDB_ROOT_PASSWORD\" --eval 'db.getSiblingDB(\"audit\").m.findOne().v'" } },
    { "row": "rabbitmq", "hosting": "RabbitMQ", "add": "builder.AddRabbitMQ(\"rabbitmq\")", "client": "rabbitmq", "resource": "rabbitmq",
