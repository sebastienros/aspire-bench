 const packageJson = JSON.parse(readFileSync('./package.json', 'utf-8'))
 const viteVersion = packageJson.devDependencies.vite.replace('^', '')
 
+// Build information shown in the player page footer, served by the dev server from the admin's
+// version endpoint. The page keeps rendering if the admin cannot answer, so fall back to placeholders.
+const versionInfoPath = '/api/version'
+const versionInfoFallback = {
+  commitSha: '',
+  commitHash: 'dev',
+  commitUrl: 'https://github.com/maddymontaquila/aspirifridays',
+  dotNetVersion: 'dev',
+  aspireVersion: 'not configured',
+  viteVersion
+}
+
+function versionInfo(adminUrl) {
+  return {
+    name: 'version-info',
+    configureServer(server) {
+      server.middlewares.use('/api/version-info', async (req, res) => {
+        let info = versionInfoFallback
+        try {
+          const response = await fetch(new URL(versionInfoPath, adminUrl), {
+            headers: { Accept: 'application/json' }
+          })
+          if (response.ok) {
+            info = await response.json()
+          }
+        } catch {
+          // Keep the placeholders.
+        }
+        res.setHeader('Content-Type', 'application/json')
+        res.end(JSON.stringify(info))
+      })
+    }
+  }
+}
+
