diff --git a/src/Aspire.Cli/Mcp/Tools/GetResourceConnectionTool.cs b/src/Aspire.Cli/Mcp/Tools/GetResourceConnectionTool.cs
new file mode 100644
index 0000000000..7c5ccf861b
--- /dev/null
+++ b/src/Aspire.Cli/Mcp/Tools/GetResourceConnectionTool.cs
@@ -0,0 +1,170 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System.Globalization;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Aspire.Cli.Backchannel;
+using Aspire.Dashboard.Model;
+using Microsoft.Extensions.Logging;
+using ModelContextProtocol;
+using ModelContextProtocol.Protocol;
+
+namespace Aspire.Cli.Mcp.Tools;
+
+/// <summary>
+/// MCP tool that tells an agent how to reach a resource's own process from a shell: for a container,
+/// its runtime ID, image, the names of the environment variables that hold its credentials, and a
+/// `docker exec` command line for the resource's own client tool. Values are never returned.
+/// </summary>
+internal sealed class GetResourceConnectionTool(IAuxiliaryBackchannelMonitor auxiliaryBackchannelMonitor, ILogger<GetResourceConnectionTool> logger) : CliMcpTool
+{
+    internal const string ToolName = "get_resource_connection";
+
+    private static readonly string[] s_credentialMarkers = ["PASSWORD", "PASS", "USER", "SECRET", "TOKEN", "KEY", "AUTH"];
+
+    public override string Name => ToolName;
+
+    public override string Description => "Get how to reach a resource's own process from a shell, to confirm a diagnosis at a dependency (database, cache, broker) with its own client tool. For a container: its ID, image, the names of the environment variables that hold its credentials (never their values), and a ready `docker exec` command line for its client (psql, redis-cli, ...) to run with the shell tool. Telemetry does not show a dependency's server-side state (slow commands, connected clients, locks, settings): use this when traces and logs point at a dependency or show nothing.";
+
+    public override JsonElement GetInputSchema()
+    {
+        return JsonDocument.Parse("""
+            {
+              "type": "object",
+              "properties": {
+                "resourceName": {
+                  "type": "string",
+                  "description": "The resource name or display name, as list_resources returns it."
+                }
+              },
+              "required": ["resourceName"]
+            }
+            """).RootElement;
+    }
+
+    public override async ValueTask<CallToolResult> CallToolAsync(CallToolContext context, CancellationToken cancellationToken)
+    {
+        string? resourceName = null;
+        if (context.Arguments?.TryGetValue("resourceName", out var nameElement) == true && nameElement.ValueKind == JsonValueKind.String)
+        {
+            resourceName = nameElement.GetString();
+        }
+
+        if (string.IsNullOrWhiteSpace(resourceName))
+        {
+            throw new McpProtocolException("The resourceName parameter is required.", McpErrorCode.InvalidParams);
+        }
+
+        var connection = await AppHostConnectionHelper.GetSelectedConnectionAsync(auxiliaryBackchannelMonitor, logger, cancellationToken).ConfigureAwait(false);
+        if (connection is null)
+        {
+            throw new McpProtocolException(McpErrorMessages.NoAppHostRunning, McpErrorCode.InternalError);
+        }
+
+        var excludedResult = await McpToolHelpers.CheckResourceExcludedAsync(connection, resourceName, cancellationToken).ConfigureAwait(false);
+        if (excludedResult is not null)
+        {
+            return excludedResult;
+        }
+
+        var snapshots = await connection.GetResourceSnapshotsAsync(includeHidden: false, cancellationToken).ConfigureAwait(false);
+        var snapshot = snapshots.FirstOrDefault(s => StringComparers.ResourceName.Equals(s.Name, resourceName))
+            ?? snapshots.FirstOrDefault(s => s.DisplayName is { } display && StringComparers.ResourceName.Equals(display, resourceName));
+        if (snapshot is null)
+        {
+            return Error($"No resource named '{resourceName}'. Call list_resources to see the resource names.");
+        }
+
+        var text = new StringBuilder();
+        var name = snapshot.DisplayName ?? snapshot.Name;
+        text.AppendLine(CultureInfo.InvariantCulture, $"Resource '{snapshot.Name}' ({snapshot.ResourceTypeDisplayName ?? snapshot.ResourceType}), state {McpToolHelpers.MapResourceState(snapshot.State) ?? "Unknown"}.");
+
+        if (!string.Equals(snapshot.ResourceType, KnownResourceTypes.Container, StringComparisons.ResourceType))
+        {
+            text.AppendLine("It is not a container: its process runs on this machine. Use list_console_logs for its output and its endpoints for requests.");
+            AppendUrls(text, snapshot);
+            return Ok(text);
+        }
+
+        var containerId = GetString(snapshot, KnownProperties.Container.Id);
+        var image = GetString(snapshot, KnownProperties.Container.Image) ?? string.Empty;
+        if (containerId is null)
+        {
+            text.AppendLine("The container ID is not available yet (the container is not running). Wait for the resource with wait_for_resources and call again.");
+            return Ok(text);
+        }
+
+        text.AppendLine(CultureInfo.InvariantCulture, $"Container ID: {containerId}");
+        if (image.Length > 0)
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"Image: {image}");
+        }
+
+        var credentialNames = snapshot.EnvironmentVariables
+            .Select(variable => variable.Name)
+            .Where(variableName => s_credentialMarkers.Any(marker => variableName.Contains(marker, StringComparison.OrdinalIgnoreCase)))
+            .Distinct(StringComparer.Ordinal)
+            .Order(StringComparer.Ordinal)
+            .ToArray();
+        if (credentialNames.Length > 0)
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"Credential variables set inside the container (names only): {string.Join(", ", credentialNames)}");
+        }
+
+        AppendUrls(text, snapshot);
+        text.AppendLine();
+        text.AppendLine("Run with the shell tool (the command runs inside the container, so no host port or password is needed):");
+
+        var lower = image.ToLowerInvariant();
+        if (lower.Contains("postgres", StringComparison.Ordinal))
+        {
+            var user = credentialNames.Contains("POSTGRES_USER") ? "\"$POSTGRES_USER\"" : "postgres";
+            text.AppendLine(CultureInfo.InvariantCulture, $"docker exec {containerId} sh -c 'PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -U {user} -d <database> -c \"<sql>\"'");
+            text.AppendLine("For example <sql> = SELECT pid, state, wait_event_type, now() - query_start AS running_for, query FROM pg_stat_activity WHERE state <> 'idle'");
+        }
+        else if (lower.Contains("redis", StringComparison.Ordinal) || lower.Contains("valkey", StringComparison.Ordinal) || lower.Contains("garnet", StringComparison.Ordinal))
+        {
+            // With TLS on, one of 6379/6380 is TLS and the other plain (swapped by microsoft/aspire#22350), so the command probes for the plain one.
+            var tls = snapshot.Urls.Any(url => url.Url.StartsWith("rediss://", StringComparison.OrdinalIgnoreCase));
+            var auth = credentialNames.Contains("REDIS_PASSWORD") ? "REDISCLI_AUTH=\"$REDIS_PASSWORD\" " : string.Empty;
+            text.AppendLine("docker exec " + containerId + " sh -c '" + (tls ? "for p in 6379 6380; do " + auth + "redis-cli -p $p PING >/dev/null 2>&1 && break; done; " + auth + "redis-cli -p $p" : auth + "redis-cli") + " <command>'");
+            text.AppendLine("For example <command> = SLOWLOG GET 10 (commands that blocked the server, with their client), CLIENT LIST (every connection and its last command), INFO commandstats");
+            if (tls)
+            {
+                text.AppendLine("One of 6379/6380 inside the container is TLS (which one depends on the Aspire version); a bare redis-cli on it fails with an I/O error, so the command above probes with PING first.");
+            }
+        }
+        else if (lower.Contains("rabbitmq", StringComparison.Ordinal))
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"docker exec {containerId} rabbitmqctl <command>");
+            text.AppendLine("For example <command> = list_queues name messages consumers, list_connections");
+        }
+        else if (lower.Contains("mssql", StringComparison.Ordinal) || lower.Contains("sqlserver", StringComparison.Ordinal))
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"docker exec {containerId} sh -c '/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -Q \"<sql>\"'");
+        }
+        else
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"docker exec {containerId} sh -c '<command>'");
+        }
+
+        return Ok(text);
+    }
+
+    private static void AppendUrls(StringBuilder text, ResourceSnapshot snapshot)
+    {
+        if (snapshot.Urls.Length > 0)
+        {
+            text.AppendLine(CultureInfo.InvariantCulture, $"Endpoints on the host: {string.Join(", ", snapshot.Urls.Select(url => $"{url.Name}={McpToolHelpers.SanitizeResourceUrl(url.Url)}"))}");
+        }
+    }
+
+    private static string? GetString(ResourceSnapshot snapshot, string property) =>
+        snapshot.Properties.TryGetValue(property, out var node) && node is JsonValue value && value.TryGetValue<string>(out var text) && text.Length > 0 ? text : null;
+
+    private static CallToolResult Ok(StringBuilder text) => new() { Content = [new TextContentBlock { Text = text.ToString().TrimEnd() }] };
+
+    private static CallToolResult Error(string text) => new() { Content = [new TextContentBlock { Text = text }], IsError = true };
+}
