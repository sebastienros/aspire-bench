@@ -127,6 +127,34 @@ internal sealed class ResourceJson
     /// Dictionary key is the command name.
     /// </summary>
     public Dictionary<string, ResourceCommandJson>? Commands { get; set; }
+
+    /// <summary>
+    /// Agentic patch (aspire-bench T2.6): how to reach the resource with its own client tool.
+    /// </summary>
+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
+    public ResourceConnectJson? Connect { get; set; }
+}
+
+/// <summary>
+/// A command line that reaches a resource with its own client tool; the caller appends the tool's arguments.
+/// </summary>
+internal sealed class ResourceConnectJson
+{
+    /// <summary>The command line, ending where the tool's own arguments go.</summary>
+    public string? Command { get; set; }
+
+    /// <summary>Where the client runs: <c>container</c> (inside the resource's container) or <c>host</c>.</summary>
+    public string? Runs { get; set; }
+
+    /// <summary>The client tool the command runs.</summary>
+    public string? Tool { get; set; }
+
+    /// <summary>What to append, with an example.</summary>
+    public string? Append { get; set; }
+
+    /// <summary>Anything an agent must know to use it.</summary>
+    [JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)]
+    public string? Note { get; set; }
 }
 
