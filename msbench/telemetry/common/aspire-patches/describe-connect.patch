diff --git a/src/Shared/Model/Serialization/ResourceJson.cs b/src/Shared/Model/Serialization/ResourceJson.cs
index 1bb876267e..90666a4fe6 100644
--- a/src/Shared/Model/Serialization/ResourceJson.cs
