+    /// <summary>
+    /// Agentic patch (aspire-bench T2.4): Aspire's Redis container serves TLS on 6379 (the port a bare
+    /// <c>redis-cli</c> uses) and plain TCP on another port, so the generic command fails with an I/O error.
+    /// Returns the command that works inside the container, read from the arguments the container was started with.
+    /// </summary>
+    internal static string? GetConnectHint(ResourceSnapshot snapshot)
+    {
+        if (!string.Equals(snapshot.ResourceTypeDisplayName, "Redis", StringComparison.OrdinalIgnoreCase) ||
+            !snapshot.Properties.TryGetValue("resource.appArgs", out var argsNode) ||
+            argsNode is not System.Text.Json.Nodes.JsonArray args)
+        {
+            return null;
+        }
+
+        var values = args.Select(static a => a?.GetValueKind() == System.Text.Json.JsonValueKind.String ? a.GetValue<string>() : null).ToList();
+        string? ValueAfter(string flag)
+        {
+            var index = values.IndexOf(flag);
+            return index >= 0 && index + 1 < values.Count ? values[index + 1] : null;
+        }
+
+        var tlsPort = ValueAfter("--tls-port");
+        var plainPort = ValueAfter("--port");
+        if (tlsPort is null || plainPort is null)
+        {
+            return null;
+        }
+
+        var auth = values.Contains("--requirepass") ? "REDISCLI_AUTH=\"$REDIS_PASSWORD\" " : "";
+        return $"Port {tlsPort} is TLS inside the container; a bare redis-cli fails there. Plain TCP is on {plainPort}: docker exec <container.id> sh -c '{auth}redis-cli -p {plainPort} <command>'";
+    }
