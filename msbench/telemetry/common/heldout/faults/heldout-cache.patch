 var api = app.MapGroup("/api");
 
-// The catalogue changes rarely, so the product list is served from memory for a short time.
-api.MapGet("/products", async (ShopDb db, IMemoryCache cache, IConfiguration configuration) =>
-    await cache.GetOrCreateAsync("products", async entry =>
+// The catalogue: every product with its units sold over the last seven days and how many
+// shoppers bought it (the storefront shows the week's bestsellers first) and, for loyalty
+// members, the member price. Ranking the week's orders is expensive, so each shopper's
+// catalogue is kept in memory for a short time.
+api.MapGet("/products", async (string? customer, ShopDb db, IMemoryCache cache, IConfiguration configuration) =>
+    await cache.GetOrCreateAsync($"products:{customer}", async entry =>
     {
         entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(configuration.GetValue("Catalog:CacheSeconds", 30));
-        return await db.Products.AsNoTracking().OrderBy(p => p.Id)
-            .Select(p => new { p.Id, p.Name, p.Price, InStock = p.Stock > 0 })
-            .ToListAsync();
+        var since = DateTime.UtcNow.AddDays(-7);
+        var sold = await db.Orders.AsNoTracking()
+            .Where(o => o.Status == OrderStatus.Confirmed && o.PlacedAt >= since)
+            .GroupBy(o => o.ProductId)
+            .Select(g => new { ProductId = g.Key, Units = g.Sum(o => o.Quantity), Shoppers = g.Select(o => o.Customer).Distinct().Count() })
+            .ToDictionaryAsync(g => g.ProductId);
+        var member = !string.IsNullOrEmpty(customer) && await db.Members.AnyAsync(m => m.Customer == customer);
+        var products = await db.Products.AsNoTracking().OrderBy(p => p.Id).ToListAsync();
+        return products
+            .Select(p => new
+            {
+                p.Id,
+                p.Name,
+                p.Price,
+                MemberPrice = member ? Math.Round(p.Price * 0.9m, 2) : (decimal?)null,
+                InStock = p.Stock > 0,
+                SoldThisWeek = sold.GetValueOrDefault(p.Id)?.Units ?? 0,
+                ShoppersThisWeek = sold.GetValueOrDefault(p.Id)?.Shoppers ?? 0,
+            })
+            .OrderByDescending(p => p.SoldThisWeek).ThenBy(p => p.Id)
+            .ToList();
     }));
 
