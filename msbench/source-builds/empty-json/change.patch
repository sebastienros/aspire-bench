 create mode 100644 tests/Aspire.Cli.Tests/Snapshots/DescribeCommandTests.DescribeCommand_JsonFormat_NoAppHostOutputsEmptyResources_commandName=resources.verified.json

diff --git a/docs/specs/cli-output-formats.md b/docs/specs/cli-output-formats.md
index 18983626a09fa53492508c585dc1832991114c09..1cb6b64469bb420890158eabc7013b5fff876acc 100644
--- a/docs/specs/cli-output-formats.md
+++ b/docs/specs/cli-output-formats.md
@@ -308,7 +308,7 @@ The output is an unfenced `flowchart LR` diagram with deterministic node identif
 
 Progress and informational messages go to stderr, so redirection captures only Mermaid source. When no AppHost is running, the command preserves the existing successful empty-result behavior and writes no diagram. `--follow` is not supported with Mermaid output; each invocation captures one snapshot. Appending multiple invocations with `>>` produces multiple diagrams, not a merged diagram.
 
-`aspire describe --format json` emits a snapshot wrapper with one or more resources:
+`aspire describe --format json` emits a snapshot wrapper with zero or more resources. When no AppHost is running, it exits successfully and emits `{"resources":[]}` (pretty-printed), with informational messages on stderr. A connected AppHost with no visible resources uses the same empty wrapper. Invalid AppHost paths, ambiguous AppHost selection, discovery failures, and missing resources in a connected AppHost remain errors rather than successful empty snapshots.
 
 ```json
 {
@@ -340,7 +340,7 @@ Progress and informational messages go to stderr, so redirection captures only M
 }
 ```
 
-`aspire describe --format json --follow` emits NDJSON. Each line is a resource object, not the snapshot wrapper:
+`aspire describe --format json --follow` emits NDJSON. Each line is a resource object, not the snapshot wrapper. When no AppHost is running, it exits successfully without emitting any records:
 
 ```json
 {"name":"api","displayName":"api","resourceType":"Project","state":"Starting","stateStyle":"info"}
diff --git a/src/Aspire.Cli/Commands/DescribeCommand.cs b/src/Aspire.Cli/Commands/DescribeCommand.cs
index a0bc77b450d96f4677b0fa043b7cc6c0823f88f2..cb0f6dc527a93a05a53edcf74d1714a5239a43e3 100644
--- a/src/Aspire.Cli/Commands/DescribeCommand.cs
+++ b/src/Aspire.Cli/Commands/DescribeCommand.cs
@@ -171,7 +171,14 @@ protected override async Task<CommandResult> ExecuteAsync(ParseResult parseResul
 
         if (!result.Success)
         {
-            return CommandResult.FromExitCode(AppHostConnectionResultHandler.DisplayFailureAsInformation(result, InteractionService));
+            var exitCode = AppHostConnectionResultHandler.DisplayFailureAsInformation(result, InteractionService);
+            if (exitCode == CliExitCodes.Success && format == ResourceOutputFormat.Json && !follow)
+            {
+                // A successful empty snapshot still needs a JSON document; follow mode has no records to emit.
+                ExecuteSnapshot([], dashboardBaseUrl: null, resourceName: null, format, includeDisabledCommands);
+            }
+
+            return CommandResult.FromExitCode(exitCode);
         }
 
         var connection = result.Connection!;
diff --git a/tests/Aspire.Cli.Tests/Commands/DescribeCommandTests.cs b/tests/Aspire.Cli.Tests/Commands/DescribeCommandTests.cs
index 620800482b562279968a5053c35b43f05e0f6e48..c976eb31529fca1ada82cc14ea5bb645ab196e84 100644
--- a/tests/Aspire.Cli.Tests/Commands/DescribeCommandTests.cs
+++ b/tests/Aspire.Cli.Tests/Commands/DescribeCommandTests.cs
@@ -48,6 +48,171 @@ public async Task DescribeCommand_WhenNoAppHostRunning_ReturnsSuccess()
         Assert.Equal(CliExitCodes.Success, exitCode);
     }
 
+    [Theory]
+    [InlineData("describe")]
+    [InlineData("resources")]
+    public async Task DescribeCommand_JsonFormat_NoAppHostOutputsEmptyResources(string commandName)
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        var services = CliTestHelper.CreateServiceCollection(workspace, outputHelper, options =>
+        {
+            options.OutputTextWriter = outputWriter;
+            options.ErrorTextWriter = errorWriter;
+            options.DisableAnsi = true;
+        });
+        using var provider = services.BuildServiceProvider();
+
+        var exitCode = await provider.GetRequiredService<RootCommand>()
+            .Parse($"{commandName} --format json --non-interactive --nologo").InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.Success, exitCode);
+        Assert.Contains(SharedCommandStrings.AppHostNotRunning, errorWriter.ToString());
+        await Verify(string.Join("", outputWriter.Logs), "json").UseParameters(commandName);
+    }
+
+    [Fact]
+    public async Task DescribeCommand_JsonFormat_ConnectedEmptyAppHostOutputsEmptyResources()
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        using var provider = CreateDescribeTestServices(workspace, outputWriter, [], disableAnsi: true, errorTextWriter: errorWriter);
+
+        var exitCode = await provider.GetRequiredService<RootCommand>()
+            .Parse("describe --format json --non-interactive --nologo").InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.Success, exitCode);
+        await Verify(string.Join("", outputWriter.Logs), "json");
+    }
+
+    [Theory]
+    [InlineData("describe --format json --follow")]
+    [InlineData("resources --format json --follow")]
+    [InlineData("describe --format mermaid")]
+    [InlineData("resources --format mermaid")]
+    public async Task DescribeCommand_NoAppHostWithoutJsonSnapshotKeepsStandardOutputEmpty(string commandLine)
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        var services = CliTestHelper.CreateServiceCollection(workspace, outputHelper, options =>
+        {
+            options.OutputTextWriter = outputWriter;
+            options.ErrorTextWriter = errorWriter;
+            options.DisableAnsi = true;
+        });
+        using var provider = services.BuildServiceProvider();
+
+        var exitCode = await provider.GetRequiredService<RootCommand>().Parse(commandLine).InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.Success, exitCode);
+        Assert.Equal("", string.Join("", outputWriter.Logs));
+        Assert.Contains(SharedCommandStrings.AppHostNotRunning, errorWriter.ToString());
+    }
+
+    [Theory]
+    [InlineData("describe")]
+    [InlineData("resources --format table")]
+    [InlineData("describe --format table --follow")]
+    public async Task DescribeCommand_NoAppHostTablePreservesInformationalOutput(string commandLine)
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        var services = CliTestHelper.CreateServiceCollection(workspace, outputHelper, options =>
+        {
+            options.OutputTextWriter = outputWriter;
+            options.ErrorTextWriter = errorWriter;
+            options.DisableAnsi = true;
+        });
+        using var provider = services.BuildServiceProvider();
+
+        var exitCode = await provider.GetRequiredService<RootCommand>().Parse(commandLine).InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.Success, exitCode);
+        Assert.Contains(SharedCommandStrings.AppHostNotRunning, string.Join("", outputWriter.Logs));
+        Assert.Equal("", errorWriter.ToString());
+    }
+
+    [Theory]
+    [InlineData("describe")]
+    [InlineData("resources")]
+    public async Task DescribeCommand_JsonFormat_InvalidAppHostPathRemainsError(string commandName)
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        var services = CliTestHelper.CreateServiceCollection(workspace, outputHelper, options =>
+        {
+            options.OutputTextWriter = outputWriter;
+            options.ErrorTextWriter = errorWriter;
+            options.DisableAnsi = true;
+        });
+        using var provider = services.BuildServiceProvider();
+
+        var exitCode = await provider.GetRequiredService<RootCommand>()
+            .Parse($"{commandName} --format json --apphost missing.csproj").InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.FailedToFindProject, exitCode);
+        Assert.Equal("", string.Join("", outputWriter.Logs));
+        Assert.Contains(InteractionServiceStrings.ProjectOptionDoesntExist, errorWriter.ToString());
+    }
+
+    [Fact]
+    public async Task DescribeCommand_JsonFormat_MissingResourceRemainsError()
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        using var provider = CreateDescribeTestServices(workspace, outputWriter, [], disableAnsi: true, errorTextWriter: errorWriter);
+
+        var exitCode = await provider.GetRequiredService<RootCommand>()
+            .Parse("describe missing --format json").InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(CliExitCodes.FailedToFindProject, exitCode);
+        Assert.Equal("", string.Join("", outputWriter.Logs));
+        Assert.Contains("Resource 'missing' not found.", errorWriter.ToString());
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task DescribeCommand_JsonFormat_DiscoveryErrorsRemainErrors(bool ambiguous)
+    {
+        using var workspace = TemporaryWorkspace.CreateForCli(outputHelper);
+        var outputWriter = new TestOutputTextWriter(outputHelper);
+        using var errorWriter = new StringWriter();
+        var monitor = new TestAuxiliaryBackchannelMonitor();
+        if (ambiguous)
+        {
+            monitor.AddConnection("socket.first", new TestAppHostAuxiliaryBackchannel { IsInScope = true });
+            monitor.AddConnection("socket.second", new TestAppHostAuxiliaryBackchannel { IsInScope = true });
+        }
+        else
+        {
+            monitor.ScanAsyncCallback = _ => throw new InvalidOperationException("Discovery failed.");
+        }
+
+        var services = CliTestHelper.CreateServiceCollection(workspace, outputHelper, options =>
+        {
+            options.OutputTextWriter = outputWriter;
+            options.ErrorTextWriter = errorWriter;
+            options.DisableAnsi = true;
+            options.AuxiliaryBackchannelMonitorFactory = _ => monitor;
+            options.CliHostEnvironmentFactory = _ => TestHelpers.CreateNonInteractiveHostEnvironment();
+        });
+        using var provider = services.BuildServiceProvider();
+
+        var exitCode = await provider.GetRequiredService<RootCommand>()
+            .Parse("describe --format json --non-interactive --nologo").InvokeAsync().DefaultTimeout();
+
+        Assert.Equal(ambiguous ? CliExitCodes.FailedToFindProject : CliExitCodes.InvalidCommand, exitCode);
+        Assert.Equal("", string.Join("", outputWriter.Logs));
+        Assert.Contains(ambiguous ? SharedCommandStrings.MultipleAppHostsNonInteractive : "Discovery failed.", errorWriter.ToString());
+    }
+
     [Theory]
     [InlineData("describe --apphost-pid 42")]
     [InlineData("describe --apphost missing.csproj --apphost-pid 0")]
