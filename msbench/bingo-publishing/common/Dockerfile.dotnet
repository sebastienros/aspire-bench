FROM mcr.microsoft.com/dotnet/sdk:10.0.100-noble AS build
ARG PROJECT
WORKDIR /src
COPY . .
RUN dotnet publish "src/${PROJECT}/${PROJECT}.csproj" -c Release -o /out \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.12-noble
ARG PROJECT
ENV APP_DLL=${PROJECT}.dll ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production DOTNET_ENVIRONMENT=Production
WORKDIR /app
COPY --from=build /out .
USER app
ENTRYPOINT ["sh", "-c", "exec dotnet \"$APP_DLL\""]
